{
  "name": "sourcepilot-ai-build",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter sourcepilot dev",
    "emit:digest-vector": "tsx scripts/emit-digest-vector.ts",
    "demo:all": "tsx --tsconfig sourcepilot/tsconfig.json scripts/harness.ts",
    "verify:claims": "tsx --tsconfig sourcepilot/tsconfig.json scripts/verify-chain-claims.ts",
    "test:chain": "pnpm --filter sourcepilot test lib/chain",
    "build": "pnpm --filter sourcepilot build",
    "test": "pnpm --filter sourcepilot test"
  },
  "devDependencies": {
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "viem": "^2.55.10"
  }
}
