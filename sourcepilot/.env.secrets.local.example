# Copy to .env.secrets.local (gitignored) and fill in real values.
# Real testnet keys live only in .env.secrets.local, never here, and never in .env.local —
# see scripts/check-env.ts for why that path is avoided.

CHAIN_ID=10143
CHAIN_RPC_URL=https://testnet-rpc.monad.xyz
MANDATE_REGISTRY_ADDRESS=

# Required by scripts/check-env.ts.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL_BACKUP1=https://rpc-testnet.monadinfra.com
MONAD_TESTNET_RPC_URL_BACKUP2=https://rpc.ankr.com/monad_testnet

# Review-contract aliases retained for schema compatibility.
MONAD_TESTNET_RPC_URL_BACKUP_1=https://rpc-testnet.monadinfra.com
MONAD_TESTNET_RPC_URL_BACKUP_2=https://rpc.ankr.com/monad_testnet

PRINCIPAL_ADDRESS=
PRINCIPAL_PRIVATE_KEY=

AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

SUPPLIER_A_ADDRESS=
SUPPLIER_A_PRIVATE_KEY=

SUPPLIER_B_ADDRESS=
SUPPLIER_B_PRIVATE_KEY=
